# Postgres. On Supabase, DATABASE_URL is the pooled connection and DIRECT_URL
# the direct one — Prisma migrations need the direct link.
DATABASE_URL="postgresql://user:password@host:5432/postgres?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/postgres?schema=public"

# From the Shopify Partner Dashboard. The CLI fills these in during `app dev`.
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_APP_URL="https://your-tunnel.example.com"

# Exactly what the app's GraphQL operations need — nothing more.
SCOPES="write_orders,read_orders,read_products"
