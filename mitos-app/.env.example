# ── Shopify ───────────────────────────────────────────────────────────────
# From the Partners dashboard, the app you created. SHOPIFY_APP_URL is the
# public address the app is deployed at — it must match the URLs registered
# in shopify.app.toml, or OAuth fails with a redirect_uri mismatch.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-app.vercel.app
SCOPES=write_orders,read_orders,read_products

# ── Database ──────────────────────────────────────────────────────────────
# Supabase → Project settings → Database → Connection string.
#
# Two URLs, and the difference matters. Serverless functions open and drop
# connections constantly, which exhausts Postgres' connection limit — so
# runtime queries go through the pooler on port 6543. Migrations cannot run
# through a pooler (they need a session, not a transaction), so they use the
# direct connection on 5432.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
