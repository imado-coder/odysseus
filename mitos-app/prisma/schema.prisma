// MITOS — cash-on-delivery commerce for Shopify.
//
// Multi-tenant from the first table: every row that belongs to a merchant
// carries shopId, and every query filters on it. Getting this wrong later
// means one merchant reading another's orders, so it is not deferred.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Supabase pooling: migrations need the direct link
}

/// Shopify's offline session. The library owns this table's shape.
model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)

  @@index([shop])
}

/// One row per installed store. Everything else hangs off this.
model Shop {
  id            String    @id @default(cuid())
  domain        String    @unique // my-store.myshopify.com
  name          String?
  email         String?
  currency      String    @default("DZD")
  installedAt   DateTime  @default(now())
  uninstalledAt DateTime?
  planName      String?

  settings     ShopSettings?
  leads        Lead[]
  orders       CodOrder[]
  rates        ShippingRate[]
  offers       Offer[]
  subscription Subscription?
  carriers     Carrier[]
  shipments    Shipment[]
  dataRequests DataRequest[]

  @@index([domain])
}

model ShopSettings {
  id     String @id @default(cuid())
  shopId String @unique
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  /// Create the Shopify order immediately, or hold the lead for a call first.
  autoCreateOrder   Boolean @default(true)
  /// Tag applied to every order this app creates, so merchants can filter.
  orderTag          String  @default("MITOS-COD")
  defaultHomeRate   Int     @default(600)
  defaultDeskRate   Int     @default(350)
  freeShippingAbove Int?
  notifyEmail       String?

  /// Secret that opens the standalone order list on a phone, outside the
  /// Shopify admin. A cash-on-delivery merchant works from the call list all
  /// day and is rarely at a desk; this lets them reach it without the
  /// embedded app. Null means no link has been issued, and the page 404s.
  dashboardToken String? @unique

  updatedAt DateTime @updatedAt
}

/// Shipping price per wilaya. Home and desk are separate columns rather than
/// a JSON blob so they can be queried, bulk-edited and reported on.
///
/// The price depends on two things, not one: the wilaya *and* the carrier.
/// Yalidine and ZR Express do not price Adrar alike, and a merchant may use
/// one carrier for the north and another for the south. So carrierId is part
/// of the identity of a row — and it is nullable, because a shop that has
/// linked no carrier still keeps its own list, which is what every existing
/// row became.
///
/// The unique index cannot be expressed here: Postgres treats two NULLs as
/// distinct, so `@@unique` on a nullable column would allow duplicate rows
/// for exactly the most common case. The migration builds it on
/// COALESCE(carrierId, '') instead.
model ShippingRate {
  id         String   @id @default(cuid())
  shopId     String
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  carrierId  String?
  carrier    Carrier? @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  wilayaCode String // "01".."58"
  homeRate   Int
  deskRate   Int
  enabled    Boolean  @default(true)

  @@index([shopId])
  @@index([carrierId])
}

/// A delivery company the merchant has linked.
///
/// Every Algerian carrier exposes a different API, but what we need from all
/// of them is the same: create a parcel, give me a tracking number, tell me
/// when the status changes. So one row describes any of them and an adapter
/// per provider does the translating.
model Carrier {
  id       String          @id @default(cuid())
  shopId   String
  shop     Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  provider CarrierProvider
  /// The merchant's own label — they may hold two accounts with one provider.
  name     String
  enabled  Boolean         @default(true)

  /// The carrier the storefront quotes from, and the one a push defaults to.
  /// A partial unique index keeps at most one per shop.
  isDefault Boolean @default(false)

  /// Push automatically the moment an order is confirmed, or wait for the
  /// merchant to press send. Off by default: a wrong parcel costs a return.
  autoPush Boolean @default(false)

  /// The Ecotrack family runs one instance per courier, each on its own host,
  /// so the base URL is data rather than a constant. Null for providers with
  /// a single fixed endpoint.
  baseUrl String?

  /// Yalidine prices and routes from an origin wilaya, and rejects a parcel
  /// without one.
  fromWilaya String?

  /// Credentials are NOT here. This is the id of a Supabase Vault secret,
  /// which holds the JSON encrypted at rest; nothing that reads this table
  /// for display can accidentally serialise a token.
  credentialsRef String?

  rates     ShippingRate[]
  shipments Shipment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, name])
  @@index([shopId])
}

/// One parcel handed to one carrier.
///
/// Created only when an order is confirmed — that is the whole point of cash
/// on delivery, and pushing at order time would send the carrier every
/// abandoned and fake order the storefront collects.
model Shipment {
  id         String   @id @default(cuid())
  shopId     String
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  carrierId  String
  carrier    Carrier  @relation(fields: [carrierId], references: [id])
  /// One shipment per order, enforced by the database rather than by care:
  /// two taps on send must not become two parcels and two delivery fees.
  codOrderId String   @unique
  codOrder   CodOrder @relation(fields: [codOrderId], references: [id], onDelete: Cascade)

  state          ShipmentState @default(QUEUED)
  trackingNumber String?
  labelUrl       String?

  /// The carrier's own words, kept raw, and our reading of them. Keeping both
  /// means a carrier changing its vocabulary shows up as an unmapped status
  /// rather than as a wrong one.
  carrierStatus String?
  mappedStatus  CodStatus?

  attempts  Int     @default(0)
  lastError String?

  /// Exactly what was sent and exactly what came back. When a carrier
  /// disputes a parcel — and they do — this is the evidence.
  request  Json?
  response Json?

  pushedAt  DateTime?
  syncedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([shopId, state])
  @@index([carrierId])
  @@index([trackingNumber])
}

enum CarrierProvider {
  YALIDINE
  ZR_EXPRESS
  ECOTRACK
  MAYSTRO
  NOEST
  /// No API: the merchant exports and pastes the tracking number back.
  MANUAL
}

enum ShipmentState {
  QUEUED
  PUSHED
  FAILED
  CANCELLED
}

/// Quantity-break pricing: buy 2 for X, buy 3 for Y.
///
/// `price` is the total for the whole quantity, not the unit price — "3 for
/// 5000 DA" is one row with quantity 3 and price 5000. Storing it per unit
/// would mean rounding a merchant's round number into thirds and charging
/// something they never typed.
///
/// The storefront shows these, but the order endpoint does not trust what it
/// sends back: it looks the offer up again by (shop, product, quantity) and
/// charges what it finds. A price that arrives in a request is a suggestion.
model Offer {
  id        String  @id @default(cuid())
  shopId    String
  shop      Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productId String // Shopify GID
  quantity  Int
  price     Int
  label     String?
  badge     String?
  featured  Boolean @default(false)

  /// Turned off rather than deleted, so an offer can end without erasing the
  /// reason an old order was priced the way it was.
  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([shopId, productId, quantity])
  @@index([shopId, productId])
}

/// What the customer submitted, exactly as submitted. Kept even when order
/// creation fails, because a failed order is still a lead worth calling.
model Lead {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  firstName  String
  lastName   String
  phone      String
  wilayaCode String
  wilayaName String
  commune    String
  address    String
  delivery   DeliveryMethod
  note       String?

  items    Json // [{ variantId, productId, title, price, qty, option }]
  subtotal Int
  shipping Int
  total    Int

  /// False when Shopify could not be reached to price the variants, so the
  /// amounts above came from the storefront and must be confirmed on the call.
  pricesVerified Boolean @default(true)

  source    String? // product page, cart drawer, landing
  userAgent String?
  ip        String?

  /// Guards against a double-tap creating two orders.
  idempotencyKey String?
  createdAt      DateTime @default(now())

  /// Set when a `customers/redact` webhook erased the personal fields above.
  /// The row survives because the money did: the merchant's revenue, the
  /// wilaya breakdown and the carrier's parcel all reference it. Without this
  /// column a redacted lead is indistinguishable from a broken one, and the
  /// call list would show a blank customer that looks like a bug.
  redactedAt DateTime?

  order CodOrder?

  @@unique([shopId, idempotencyKey])
  @@index([shopId, createdAt])
  @@index([shopId, phone])
}

/// The MITOS side of an order. The Shopify order is the source of truth for
/// money; this row is the source of truth for the call-and-deliver workflow,
/// which Shopify has no concept of.
model CodOrder {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  leadId String @unique
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  shopifyOrderId String? // gid://shopify/Order/123
  shopifyName    String? // #1001
  createFailed   Boolean @default(false)
  createError    String?

  status         CodStatus @default(PENDING)
  carrier        String?
  trackingNumber String?
  confirmedAt    DateTime?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  cancelledAt    DateTime?
  cancelReason   String?

  shipment Shipment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId, status])
  @@index([shopId, createdAt])
  @@index([shopifyOrderId])
}

/// A `customers/data_request` webhook that Shopify delivered.
///
/// Only the *request* is stored, never the answer. Shopify gives no API to
/// reply to one — the app has to hand the data to the merchant, who hands it
/// to the shopper — so the obvious design is to assemble the export here and
/// keep it. That would copy the shopper's name, phone and address into a
/// second table, and a later `customers/redact` would then have to find and
/// erase the copy too. Instead the export is assembled on demand from the
/// rows that already exist, which means a redaction that arrives first simply
/// leaves nothing to export — which is the correct outcome, not a bug.
model DataRequest {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  /// Shopify's own id for the request, so a redelivery is not a second row.
  shopifyRequestId String? @unique
  customerId       String?
  /// Kept because it is the only field that can find the shopper's leads —
  /// Lead has no email column. Cleared when that customer is redacted.
  customerPhone    String?
  /// Numeric Shopify order ids the shopper asked about; empty means "all".
  orderIds         String[]

  createdAt   DateTime  @default(now())
  /// Stamped when the merchant has downloaded the export.
  deliveredAt DateTime?

  @@index([shopId, createdAt])
}

model Subscription {
  id               String    @id @default(cuid())
  shopId           String    @unique
  shop             Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  chargeId         String? // Shopify AppSubscription GID
  plan             String    @default("Essentiel")
  /// Shopify's own vocabulary, upper case: ACTIVE, CANCELLED, FROZEN, EXPIRED…
  /// plus NONE, which is this app's word for "Shopify lists no subscription".
  status           String    @default("NONE")
  /// A test subscription charges nobody. Stored so the pricing screen can say
  /// so — a shop billed in test mode by mistake is otherwise invisible until
  /// the money does not arrive.
  isTest           Boolean   @default(false)
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  updatedAt        DateTime  @updatedAt
}

/// Reference data, shared by every shop — no shopId here on purpose.
model Wilaya {
  code     String    @id // "01".."58"
  nameFr   String
  nameAr   String
  communes Commune[]
}

model Commune {
  id         Int    @id @default(autoincrement())
  wilayaCode String
  wilaya     Wilaya @relation(fields: [wilayaCode], references: [code], onDelete: Cascade)
  nameFr     String
  nameAr     String

  @@index([wilayaCode])
}

enum DeliveryMethod {
  HOME
  DESK
}

enum CodStatus {
  PENDING // submitted, not yet called
  CONFIRMED // customer confirmed by phone
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  NO_ANSWER
}
