{%- comment -%}
  Cash-on-delivery lead form.
  Wilaya and commune come from assets/dz-locations.js (58 wilayas, 1541
  communes). Tariffs and the destination endpoint come from theme settings, so
  the merchant owns pricing and the app owns delivery.
  Params: id (unique), product, variant, block (for per-product copy).
{%- endcomment -%}
{%- liquid
  assign s = block.settings
  assign unit = variant.price | divided_by: 100

  # A literal "{}" inside an output tag closes the tag early — Liquid sees the
  # "}}" and stops. The defaults are built from characters instead.
  assign brace_open = '{'
  assign brace_close = '}'
  assign empty_object = brace_open | append: brace_close

  assign tariffs = settings.cod_tariffs | default: empty_object
  assign tariff_fallback = settings.cod_tariff_fallback | default: '[600,350]'

  # Defaults live here, not only in the section schema.
  #
  # This snippet is rendered from two places: the product section, which
  # passes its cod_form block, and the cart drawer, which is rendered from
  # layout/theme.liquid and has no section block to pass. Reading
  # block.settings directly meant the drawer's copy came out with every
  # label, placeholder and button empty — a form of red asterisks and
  # blank boxes. A snippet used from outside a section has to carry its
  # own copy.

  assign f_display = s.display | default: 'button'
  assign f_cta_label = s.cta_label | default: 'Commander — paiement à la livraison'
  assign f_cta_note = s.cta_note | default: 'Payez à la réception · Livraison 58 wilayas'
  assign f_head_icon = s.head_icon | default: '💵'
  assign f_head_title = s.head_title | default: 'Commander — paiement à la livraison'
  assign f_head_subtitle = s.head_subtitle | default: 'Remplissez le formulaire, payez à la réception'
  assign f_label_first = s.label_first | default: 'Prénom'
  assign f_ph_first = s.ph_first | default: 'Nassim'
  assign f_label_last = s.label_last | default: 'Nom'
  assign f_ph_last = s.ph_last | default: 'Benali'
  assign f_label_phone = s.label_phone | default: 'Téléphone'
  assign f_phone_prefix = s.phone_prefix | default: '+213'
  assign f_ph_phone = s.ph_phone | default: '0555 00 00 00'
  assign f_phone_pattern = s.phone_pattern | default: '^0[567][0-9]{8}$|^0[1-4][0-9]{7,8}$'
  assign f_hint_phone = s.hint_phone | default: 'Nous vous appelons pour confirmer.'
  assign f_label_wilaya = s.label_wilaya | default: 'Wilaya'
  assign f_ph_wilaya = s.ph_wilaya | default: 'Choisir la wilaya…'
  assign f_label_commune = s.label_commune | default: 'Commune'
  assign f_ph_commune = s.ph_commune | default: 'Choisir la commune…'
  assign f_ph_commune_empty = s.ph_commune_empty | default: 'Choisissez d\'abord la wilaya'
  assign f_label_address = s.label_address | default: 'Adresse de livraison'
  assign f_ph_address = s.ph_address | default: 'Cité, rue, numéro, point de repère…'
  assign f_hint_address = s.hint_address | default: 'Plus l\'adresse est précise, plus la livraison est rapide.'
  assign f_label_delivery = s.label_delivery | default: 'Mode de livraison'
  assign f_label_home = s.label_home | default: 'À domicile'
  assign f_label_desk = s.label_desk | default: 'Bureau de livraison'
  assign f_label_qty = s.label_qty | default: 'Quantité'
  assign f_label_subtotal = s.label_subtotal | default: 'Sous-total'
  assign f_label_shipping = s.label_shipping | default: 'Livraison'
  assign f_label_total = s.label_total | default: 'Total à payer'
  assign f_submit_label = s.submit_label | default: 'Confirmer la commande'
  assign f_reassure = s.reassure | default: 'Aucun paiement en ligne — vous payez à la réception.'
  assign f_msg_required = s.msg_required | default: 'Ce champ est obligatoire'
  assign f_msg_phone = s.msg_phone | default: 'Numéro invalide. Exemple : 0555 00 00 00'
  assign f_msg_invalid = s.msg_invalid | default: 'Merci de corriger les champs signalés en rouge.'
  assign f_msg_success = s.msg_success | default: 'Commande enregistrée. Nous vous appelons bientôt.'
  assign f_msg_fail = s.msg_fail | default: 'Envoi impossible. Réessayez ou appelez-nous.'
  assign f_msg_pending = s.msg_pending | default: 'Formulaire valide. Connectez l\'application COD pour enregistrer la commande.'
  assign f_head_bg = s.head_bg
  assign f_submit_bg = s.submit_bg
  assign f_qty_max = s.qty_max | default: 10

  # `default` treats false as missing, so a merchant who unticked a box
  # would have it ticked again. Booleans are resolved explicitly.
  assign f_cta_show_discount = true
  if block != blank and s.cta_show_discount == false
    assign f_cta_show_discount = false
  endif
  assign f_show_head = true
  if block != blank and s.show_head == false
    assign f_show_head = false
  endif
  assign f_show_delivery = true
  if block != blank and s.show_delivery == false
    assign f_show_delivery = false
  endif
  assign f_show_qty = true
  if block != blank and s.show_qty == false
    assign f_show_qty = false
  endif
  assign f_show_summary = true
  if block != blank and s.show_summary == false
    assign f_show_summary = false
  endif
-%}
<form class="cod" data-cod-form id="{{ id }}"
      data-unit-price="{{ unit }}"
      data-tariffs='{{ tariffs }}'
      data-tariff-fallback='{{ tariff_fallback }}'
      {% if settings.cod_endpoint != blank %}data-endpoint="{{ settings.cod_endpoint }}"{% endif %}
      data-msg-invalid="{{ f_msg_invalid | escape }}"
      data-msg-success="{{ f_msg_success | escape }}"
      data-msg-fail="{{ f_msg_fail | escape }}"
      data-msg-pending="{{ f_msg_pending | escape }}"
      novalidate>
  <input type="hidden" name="product_id" value="{{ product.id }}">
  <input type="hidden" name="variant_id" value="{{ variant.id }}">
  <input type="hidden" name="product_title" value="{{ product.title | escape }}">

  {%- if f_show_head -%}
    <div class="cod__head" style="{% if f_head_bg != blank %}background: {{ f_head_bg }};{% endif %}">
      {%- if f_head_icon != blank -%}
        <span class="cod__head-icon" aria-hidden="true">{{ f_head_icon }}</span>
      {%- endif -%}
      <span class="cod__head-text">
        <span class="cod__title">{{ f_head_title }}</span>
        {%- if f_head_subtitle != blank -%}
          <span class="cod__subtitle">{{ f_head_subtitle }}</span>
        {%- endif -%}
      </span>
    </div>
  {%- endif -%}

  <div class="cod__body">
    <div class="cod__row cod__row--2">
      <div class="field">
        <label class="field__label" for="{{ id }}-prenom">{{ f_label_first }} <span class="field__req" aria-hidden="true">*</span></label>
        <input class="field__control" id="{{ id }}-prenom" name="prenom" type="text"
               autocomplete="given-name" placeholder="{{ f_ph_first | escape }}" data-cod-required>
        <span class="field__error"><span aria-hidden="true">&#9888;</span> {{ f_msg_required }}</span>
      </div>
      <div class="field">
        <label class="field__label" for="{{ id }}-nom">{{ f_label_last }} <span class="field__req" aria-hidden="true">*</span></label>
        <input class="field__control" id="{{ id }}-nom" name="nom" type="text"
               autocomplete="family-name" placeholder="{{ f_ph_last | escape }}" data-cod-required>
        <span class="field__error"><span aria-hidden="true">&#9888;</span> {{ f_msg_required }}</span>
      </div>
    </div>

    <div class="cod__row">
      <div class="field">
        <label class="field__label" for="{{ id }}-tel">{{ f_label_phone }} <span class="field__req" aria-hidden="true">*</span></label>
        <span class="field__affix">
          <span class="field__affix-label" aria-hidden="true">{{ f_phone_prefix }}</span>
          <input class="field__control" id="{{ id }}-tel" name="telephone" type="tel"
                 inputmode="numeric" autocomplete="tel-national" placeholder="{{ f_ph_phone | escape }}"
                 data-cod-required data-cod-pattern="{{ f_phone_pattern }}">
        </span>
        {%- if f_hint_phone != blank -%}<span class="field__hint">{{ f_hint_phone }}</span>{%- endif -%}
        <span class="field__error"><span aria-hidden="true">&#9888;</span> {{ f_msg_phone }}</span>
      </div>
    </div>

    <div class="cod__row cod__row--2">
      <div class="field">
        <label class="field__label" for="{{ id }}-wilaya">{{ f_label_wilaya }} <span class="field__req" aria-hidden="true">*</span></label>
        <select class="field__control" id="{{ id }}-wilaya" name="wilaya"
                autocomplete="address-level1" data-cod-wilaya data-cod-required>
          <option value="">{{ f_ph_wilaya }}</option>
        </select>
        <span class="field__error"><span aria-hidden="true">&#9888;</span> {{ f_msg_required }}</span>
      </div>
      <div class="field">
        <label class="field__label" for="{{ id }}-commune">{{ f_label_commune }} <span class="field__req" aria-hidden="true">*</span></label>
        <select class="field__control" id="{{ id }}-commune" name="commune"
                autocomplete="address-level2" data-cod-commune data-cod-required
                data-placeholder="{{ f_ph_commune | escape }}"
                data-placeholder-empty="{{ f_ph_commune_empty | escape }}" disabled>
          <option value="">{{ f_ph_commune_empty }}</option>
        </select>
        <span class="field__error"><span aria-hidden="true">&#9888;</span> {{ f_msg_required }}</span>
      </div>
    </div>

    <div class="cod__row">
      <div class="field">
        <label class="field__label" for="{{ id }}-adresse">{{ f_label_address }} <span class="field__req" aria-hidden="true">*</span></label>
        <textarea class="field__control" id="{{ id }}-adresse" name="adresse"
                  autocomplete="street-address" placeholder="{{ f_ph_address | escape }}" data-cod-required></textarea>
        {%- if f_hint_address != blank -%}<span class="field__hint">{{ f_hint_address }}</span>{%- endif -%}
        <span class="field__error"><span aria-hidden="true">&#9888;</span> {{ f_msg_required }}</span>
      </div>
    </div>

    {%- if f_show_delivery -%}
      <fieldset class="cod__fieldset">
        <legend class="cod__legend">{{ f_label_delivery }}</legend>
        <div class="cod__delivery">
          <label class="dopt">
            <input class="dopt__input" type="radio" name="livraison" value="home" data-cod-delivery checked>
            <span class="dopt__mark" aria-hidden="true"></span>
            <span class="dopt__text">
              <span class="dopt__name">{{ f_label_home }}</span>
              <span class="dopt__price" data-cod-opt-price data-idle="—">—</span>
            </span>
          </label>
          <label class="dopt">
            <input class="dopt__input" type="radio" name="livraison" value="desk" data-cod-delivery>
            <span class="dopt__mark" aria-hidden="true"></span>
            <span class="dopt__text">
              <span class="dopt__name">{{ f_label_desk }}</span>
              <span class="dopt__price" data-cod-opt-price data-idle="—">—</span>
            </span>
          </label>
        </div>
      </fieldset>
    {%- endif -%}

    {%- if f_show_qty -%}
      <div class="cod__row cod__row--2">
        <div class="field">
          <label class="field__label" for="{{ id }}-qte">{{ f_label_qty }}</label>
          <select class="field__control" id="{{ id }}-qte" name="quantite" data-cod-qty>
            {%- for i in (1..f_qty_max) -%}<option>{{ i }}</option>{%- endfor -%}
          </select>
        </div>
      </div>
    {%- endif -%}

    {%- if f_show_summary -%}
      <dl class="cod__summary">
        <div class="cod__line"><dt>{{ f_label_subtotal }}</dt><dd data-cod-out-sub>—</dd></div>
        <div class="cod__line"><dt>{{ f_label_shipping }}</dt><dd data-cod-out-ship class="cod__muted">—</dd></div>
        <div class="cod__line cod__line--total"><dt>{{ f_label_total }}</dt><dd data-cod-out-total>—</dd></div>
      </dl>
    {%- endif -%}

    <button class="cod__submit" type="submit" data-cod-submit
            style="{% if f_submit_bg != blank %}background: {{ f_submit_bg }};{% endif %}">
      <span class="cod__spinner" aria-hidden="true" hidden></span>
      {{ f_submit_label }}
    </button>

    {%- if f_reassure != blank -%}
      <p class="cod__reassure"><span aria-hidden="true">&#128274;</span> {{ f_reassure }}</p>
    {%- endif -%}

    <p class="cod__status" data-cod-status role="status" aria-live="polite"></p>
  </div>
</form>
