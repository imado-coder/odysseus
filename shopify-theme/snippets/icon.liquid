{%- endcapture -%}
{%- comment -%}
  Two wrappers: most icons are stroked line art, but the trust marks are solid
  shapes — a hairline outline reads as grey and weightless beside them.
{%- endcomment -%}
{%- assign solid = 'truck-fast,shield-fill,guarantee' | split: ',' -%}
{%- if solid contains name -%}
  <svg class="icon icon--solid {{ class }}" viewBox="0 0 24 24" fill="currentColor"
       aria-hidden="true" focusable="false">{{ svg }}</svg>
{%- else -%}
  <svg class="icon {{ class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor"
       stroke-width="{{ weight | default: 1.7 }}" stroke-linecap="round" stroke-linejoin="round"
       aria-hidden="true" focusable="false">{{ svg }}</svg>
{%- endif -%}
