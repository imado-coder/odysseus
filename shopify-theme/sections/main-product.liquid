{%- comment -%}
  Product page. The media column scrolls, the buy box sticks.
  The buy box is a library of blocks: the merchant adds only what a given
  product needs, in the order they want, and every string is theirs.
{%- endcomment -%}
{{ 'product-page.css' | asset_url | stylesheet_tag }}
{{ 'pdp-mobile.css' | asset_url | stylesheet_tag }}
{{ 'cod-form.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Filters cannot be used inside an `if` condition, so the count is assigned
  first. The wilaya/commune data is 54KB, and only loaded when the merchant
  has actually placed the order form on the page.
{%- endcomment -%}
{%- liquid
  assign cod_blocks = section.blocks | where: 'type', 'cod_form'
  assign cod_block_count = cod_blocks | size
-%}
{%- if cod_block_count > 0 -%}
  <script src="{{ 'dz-locations.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- liquid
  assign v = product.selected_or_first_available_variant
  # render arguments are plain values, never expressions: a filter here is
  # a parse error and the whole form is silently dropped.
  assign cod_form_id = 'cod-' | append: section.id
  assign cod_mobile_id = 'cod-mobile-' | append: section.id
  assign on_sale = false
  if v.compare_at_price > v.price
    assign on_sale = true
    assign off = v.compare_at_price | minus: v.price | times: 100.0 | divided_by: v.compare_at_price | round
  endif
-%}

<div class="pdp{% if section.settings.mobile_immersive %} pdp--immersive{% endif %}"
     style="--pdp-media-ratio: {{ section.settings.media_ratio | default: '3 / 4' }};">
  <div class="pdp__inner">
    {%- if section.settings.show_breadcrumbs -%}
      <nav class="pdp__crumbs" aria-label="{{ 'general.breadcrumbs.label' | t }}">
        <a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a>
        <span class="pdp__crumb-sep" aria-hidden="true">&rsaquo;</span>
        {%- if collection -%}
          <a href="{{ collection.url }}">{{ collection.title }}</a>
          <span class="pdp__crumb-sep" aria-hidden="true">&rsaquo;</span>
        {%- endif -%}
        <span class="pdp__crumb-current">{{ product.title }}</span>
      </nav>
    {%- endif -%}

    <div class="pdp__grid">
      {%- comment -%}
        Three regions, not two. The description has to be able to sit below
        the buy box on a phone — price, options and the order button come
        straight after the images, because a shopper on a phone decides there.
        Keeping the description inside the media column made that impossible.
      {%- endcomment -%}
      <div class="pdp__media pdp__gallery">
        {% render 'product-gallery', product: product, variant: v %}
      </div>

      <div class="pdp__buybox" data-sticky-fit>
        <div class="bb">
          {%- for block in section.blocks -%}
            {%- case block.type -%}

              {%- when 'savings' -%}
                <div class="bb__savings {% if block.settings.style == 'flash' %}bb__savings--flash{% endif %}" {{ block.shopify_attributes }}>
                  <span class="bb__savings-flag">
                    {%- if block.settings.icon != blank %}<span aria-hidden="true">{{ block.settings.icon }}</span> {% endif -%}
                    {{ block.settings.flag }}
                  </span>
                  <span class="bb__savings-list">
                    {%- if block.settings.item_1 != blank -%}<span class="bb__savings-item"><span aria-hidden="true">&#10004;</span> {{ block.settings.item_1 }}</span>{%- endif -%}
                    {%- if block.settings.item_2 != blank -%}<span class="bb__savings-item"><span aria-hidden="true">&#10004;</span> {{ block.settings.item_2 }}</span>{%- endif -%}
                  </span>
                </div>

              {%- when 'title' -%}
                {%- comment -%}
                  On a phone the title is clamped to two lines with a caret
                  that opens the rest of it and the description — a long title
                  pushing the price below the fold costs the sale. Without
                  JavaScript the disclosure is simply open, so nothing is
                  hidden from a shopper whose script failed.
                {%- endcomment -%}
                <div class="bb__title-row" {{ block.shopify_attributes }}>
                  <button class="bb__title-toggle" type="button"
                          data-disclosure
                          aria-expanded="false"
                          aria-controls="TitleMore-{{ section.id }}">
                    <h1 class="bb__title bb__title--clamped">{{ product.title }}</h1>
                    <span class="bb__title-caret icon-wrap" aria-hidden="true">
                      {% render 'icon', name: 'chevron-down' %}
                    </span>
                    <span class="visually-hidden">{{ block.settings.more_label | default: 'Voir plus' }}</span>
                  </button>
                </div>

                <div class="bb__title-more" id="TitleMore-{{ section.id }}" data-open="false">
                  {%- if product.description != blank -%}
                    <div class="bb__title-desc rte">{{ product.description | strip_html | truncatewords: 60 }}</div>
                  {%- endif -%}
                </div>

              {%- when 'rating' -%}
                {%- assign r = product.metafields.reviews.rating.value -%}
                <div class="bb__rating" {{ block.shopify_attributes }}>
                  {%- if r != blank -%}
                    <span class="bb__rating-score">{{ r.rating }}</span>
                    {%- comment -%} Masked shape, filled by percentage — glyph half-stars are unavailable in most fonts. {%- endcomment -%}
                    {%- assign pct = r.rating | times: 100.0 | divided_by: r.scale_max | round: 2 -%}
                    <span class="stars bb__rating-stars" style="--stars-fill: {{ pct }}%" aria-hidden="true"></span>
                    <span class="visually-hidden">{{ 'products.product.rating' | t }} {{ r.rating }}/{{ r.scale_max }}</span>
                  {%- endif -%}
                  {%- if block.settings.sold_text != blank -%}
                    <span class="bb__rating-count">{{ block.settings.sold_text }}</span>
                  {%- endif -%}
                  {%- if block.settings.seller_label != blank -%}
                    <span class="bb__rating-sep" aria-hidden="true">|</span>
                    <span>{{ block.settings.seller_label }}</span>
                    {%- if block.settings.seller_badge != blank -%}
                      <span class="bb__seller-badge"><span aria-hidden="true">&#9733;</span> {{ block.settings.seller_badge }}</span>
                    {%- endif -%}
                  {%- endif -%}
                </div>

              {%- comment -%}
                Rank. A bestseller claim the shopper cannot question is just
                a sticker, so the whole row opens the sheet that says what the
                ranking counts and over what period — the merchant writes it,
                because only they know.
              {%- endcomment -%}
              {%- when 'rank' -%}
                <div class="bb__rank" {{ block.shopify_attributes }}>
                  <button class="bb__rank-head" type="button"
                          data-sheet-open aria-controls="RankSheet-{{ block.id }}">
                    <span class="bb__rank-badge" data-pop style="{% if block.settings.badge_bg != blank %}background: {{ block.settings.badge_bg }};{% endif %}">
                      {% render 'icon', name: 'trophy' %}{{ block.settings.badge }}
                    </span>
                    <span class="bb__rank-text">{{ block.settings.text }}</span>
                    <span class="bb__rank-chev" aria-hidden="true">{% render 'icon', name: 'chevron' %}</span>
                  </button>
                </div>

              {%- comment -%}
                The saving is the argument, so the page makes it once in the
                open: the figure starts at what the item was worth and falls
                to today's price, and the struck price flinches as it lands.

                The animation is opt-in per shop and it is additive — the
                final price is what Liquid rendered, so with scripting off,
                reduced motion on, or the setting unticked, the shopper sees
                the correct price immediately and nothing else changes.
              {%- endcomment -%}
              {%- when 'price' -%}
                <div class="bb__price-row" data-price-row {{ block.shopify_attributes }}>
                  {%- if on_sale and block.settings.show_compare -%}
                    <s class="bb__price-was">
                      <span class="visually-hidden">{{ 'products.product.regular_price' | t }} </span>{{ v.compare_at_price | money }}
                    </s>
                  {%- endif -%}
                  <span class="bb__price-deal">
                    {%- if block.settings.icon != blank -%}<span aria-hidden="true">{{ block.settings.icon }}</span>{%- endif -%}
                    {%- if block.settings.label != blank -%}<span class="bb__price-label">{{ block.settings.label }}</span>{%- endif -%}
                    <span class="bb__price-now"
                          {%- if on_sale and block.settings.count_price %}
                            data-price-count
                            data-from="{{ v.compare_at_price | divided_by: 100.0 }}"
                            data-to="{{ v.price | divided_by: 100.0 }}"
                          {%- endif -%}>{{ v.price | money }}</span>
                  </span>
                </div>
                {%- comment -%}
                  The explanatory line and the discount badge are separated so
                  the badge can share a row with the stock warning, as on the
                  reference. Kept together they were too wide for 390px and the
                  warning fell to a line of its own.
                {%- endcomment -%}
                {%- if block.settings.note != blank -%}
                  <p class="bb__price-note">{{ block.settings.note }}</p>
                {%- endif -%}
                {%- if on_sale and block.settings.show_discount -%}
                  <span class="bb__off bb__off--chip" data-pop
                        {% if block.settings.count_price %}data-count-to="{{ off }}"{% endif %}
                        style="{% if block.settings.off_bg != blank %}background: {{ block.settings.off_bg }};{% endif %}">
                    {{ block.settings.off_prefix }}{{ off }}{{ block.settings.off_suffix }}
                  </span>
                {%- endif -%}

              {%- when 'notice' -%}
                <span class="bb__notice bb__notice--inline" data-pop {{ block.shopify_attributes }}
                      style="{% if block.settings.color != blank %}border-color: {{ block.settings.color }}; color: {{ block.settings.color }};{% endif %}">
                  {{ block.settings.text }}
                  {%- if block.settings.show_info %} <span aria-hidden="true">&#9432;</span>{% endif -%}
                </span>

              {%- when 'promo' -%}
                <div class="bb__promo" {{ block.shopify_attributes }}
                     style="{% if block.settings.color != blank %}border-color: {{ block.settings.color }};{% endif %}">
                  <div class="bb__promo-head" style="{% if block.settings.color != blank %}background: {{ block.settings.color }};{% endif %}">
                    <span class="bb__promo-name">{{ block.settings.name }}</span>
                    <span class="bb__promo-rule" aria-hidden="true"></span>
                    {%- if block.settings.deadline != blank -%}
                      {%- comment -%}
                        The label is wrapped so it can be the part that gives
                        way. Left as a bare text node it wrapped to a second
                        line and doubled the height of the whole panel — and
                        the clock is the one thing in here that must never
                        shrink or truncate.
                      {%- endcomment -%}
                      <span class="bb__promo-timer" data-countdown="{{ block.settings.deadline }}">
                        <span class="bb__promo-clock" aria-hidden="true">{% render 'icon', name: 'clock-fill' %}</span>
                        <span class="bb__promo-until">{{ block.settings.timer_label }}</span>
                        <span class="bb__promo-out" data-countdown-out>--:--:--</span>
                      </span>
                    {%- endif -%}
                  </div>
                  {%- if block.settings.body != blank -%}
                    <div class="bb__promo-body">{{ block.settings.body }}</div>
                  {%- endif -%}
                </div>

              {%- when 'variants' -%}
                {%- unless product.has_only_default_variant -%}
                  {% render 'variant-picker', product: product, variant: v, block: block %}
                {%- endunless -%}

              {%- when 'quantity' -%}
                {%- comment -%}
                  A stepper, not a dropdown. Picking "2" from a select on a
                  phone opens a full-screen wheel for a number the shopper
                  wanted to nudge by one.
                {%- endcomment -%}
                <div class="qty" {{ block.shopify_attributes }}>
                  <span class="qty__label" id="QtyLabel-{{ section.id }}">{{ block.settings.label }}</span>

                  <span class="qty__control" data-qty>
                    <button class="qty__btn" type="button" data-qty-minus
                            aria-label="{{ block.settings.minus_label | default: 'Retirer un' | escape }}">&minus;</button>
                    <input class="qty__input" type="number" name="quantity"
                           form="AddToCart-{{ section.id }}"
                           value="1" min="1" max="{{ block.settings.max }}" step="1"
                           inputmode="numeric"
                           aria-labelledby="QtyLabel-{{ section.id }}">
                    <button class="qty__btn" type="button" data-qty-plus
                            aria-label="{{ block.settings.plus_label | default: 'Ajouter un' | escape }}">+</button>
                  </span>

                  {%- if block.settings.sold_text != blank -%}
                    <span class="qty__sold">
                      {% render 'icon', name: 'flame' %} {{ block.settings.sold_text }}
                    </span>
                  {%- endif -%}
                </div>

              {%- when 'cta' -%}
                {%- form 'product', product, id: 'AddToCart-' | append: section.id -%}
                  <input type="hidden" name="id" value="{{ v.id }}">
                  <button class="bb__cta" type="submit" name="add"
                          {% unless v.available %}disabled{% endunless %}
                          style="{% if block.settings.bg != blank %}background: {{ block.settings.bg }};{% endif %}"
                          {{ block.shopify_attributes }}>
                    {%- if v.available -%}{{ block.settings.label }}{%- else -%}{{ block.settings.sold_out_label }}{%- endif -%}
                  </button>
                {%- endform -%}

              {%- when 'cod_form' -%}
                {%- comment -%}
                  A form that is already open on arrival is a wall of fields
                  before the shopper has decided anything. Default is the
                  call-to-action: one button carrying the offer, the form
                  revealed on the tap that means "I want this". Merchants who
                  prefer the form in view can switch to `inline`.
                {%- endcomment -%}
                {%- if block.settings.display == 'inline' -%}
                  <div {{ block.shopify_attributes }}>
                    {% render 'cod-form', id: cod_form_id, product: product, variant: v, block: block %}
                  </div>
                {%- else -%}
                  <div class="cod-wrap" data-cod-wrap data-open="false" {{ block.shopify_attributes }}>
                    <button class="cod-cta" type="button" data-cod-reveal>
                      <span class="cod-cta__main">
                        {%- if on_sale and block.settings.cta_show_discount -%}
                          <span class="cod-cta__off">-{{ off }}%</span>
                        {%- endif -%}
                        {{ block.settings.cta_label | default: 'Commander — paiement à la livraison' }}
                      </span>
                      {%- if block.settings.cta_note != blank -%}
                        <span class="cod-cta__note">{{ block.settings.cta_note }}</span>
                      {%- endif -%}
                    </button>

                    <div class="cod-wrap__panel">
                      {% render 'cod-form', id: cod_form_id, product: product, variant: v, block: block %}
                    </div>
                  </div>
                {%- endif -%}

              {%- comment -%}
                Delivery promises.

                Each promise is one row: a flat icon, the headline as a green
                link, an optional trailing note, and a chevron on the far
                right that says there is more behind it. Emoji were doing the
                icon job before — they carry the vendor's own colour, cannot
                be themed, and render differently on every phone.
              {%- endcomment -%}
              {%- when 'shipping' -%}
                {%- assign ship_row_icon = block.settings.icon_name | default: 'truck-fast' -%}
                <div class="trow" {{ block.shopify_attributes }}>
                  {%- if block.settings.title != blank -%}
                    <button class="trow__head" type="button"
                            data-sheet-open aria-controls="ShipSheet-{{ block.id }}">
                      <span class="trow__icon">{% render 'icon', name: ship_row_icon %}</span>
                      <span class="trow__title">{{ block.settings.title }}</span>
                      {%- if block.settings.trailing != blank -%}
                        <span class="trow__trail">{{ block.settings.trailing }}</span>
                      {%- endif -%}
                      <span class="trow__chev" aria-hidden="true">{% render 'icon', name: 'chevron' %}</span>
                    </button>
                  {%- endif -%}
                  {%- if block.settings.line != blank -%}
                    <span class="trow__sub">{{ block.settings.line }}</span>
                  {%- endif -%}
                </div>

              {%- when 'carriers' -%}
                <div class="trow trow--flat" {{ block.shopify_attributes }}>
                  <span class="carriers">
                    {%- if block.settings.label != blank -%}
                      <span class="carriers__label">{{ block.settings.label }}</span>
                    {%- endif -%}
                    {%- assign names = block.settings.names | split: ',' -%}
                    {%- for n in names -%}
                      <span class="carrier">
                        {%- liquid
                          assign logo_key = 'logo_' | append: forloop.index
                          assign logo = block.settings[logo_key]
                          # A filtered value cannot be passed as a filter argument, so the
                          # trimmed name is assigned before image_tag sees it.
                          assign carrier_name = n | strip
                        -%}
                        {%- if logo != blank -%}
                          {{ logo | image_url: height: 18 | image_tag: class: 'carrier__logo', alt: carrier_name, loading: 'lazy' }}
                        {%- else -%}
                          <span class="carrier__mark">{{ carrier_name | slice: 0, 3 | upcase }}</span>
                        {%- endif -%}
                        <span class="carrier__name">{{ carrier_name }}</span>
                      </span>
                    {%- endfor -%}
                  </span>
                </div>

              {%- when 'guarantees' -%}
                {%- liquid
                  assign sec_row_icon = block.settings.icon_name_1 | default: 'shield-fill'
                  assign guar_row_icon = block.settings.icon_name_2 | default: 'guarantee'
                -%}
                {%- comment -%}
                  This block owns two rows, so it needs a wrapper — and the
                  wrapper makes its first row a :first-child, which is what
                  the "no rule above the first row" rule keys on. The class
                  tells that rule this is a group inside the list, not the
                  top of it, so the hairline above the row comes back.
                {%- endcomment -%}
                <div class="trow-group" {{ block.shopify_attributes }}>
                  {%- if block.settings.line_1 != blank -%}
                    <div class="trow">
                      <button class="trow__head" type="button"
                              data-sheet-open aria-controls="SecSheet-{{ block.id }}">
                        <span class="trow__icon">{% render 'icon', name: sec_row_icon %}</span>
                        <span class="trow__title">{{ block.settings.line_1 }}</span>
                        <span class="trow__chev" aria-hidden="true">{% render 'icon', name: 'chevron' %}</span>
                      </button>
                    </div>
                  {%- endif -%}
                  {%- if block.settings.line_2 != blank -%}
                    <div class="trow">
                      <button class="trow__head" type="button"
                              data-sheet-open aria-controls="GuarSheet-{{ block.id }}">
                        <span class="trow__icon">{% render 'icon', name: guar_row_icon %}</span>
                        <span class="trow__title">{{ block.settings.line_2 }}</span>
                        {%- if block.settings.trailing_2 != blank -%}
                          <span class="trow__trail">{{ block.settings.trailing_2 }}</span>
                        {%- endif -%}
                        <span class="trow__chev" aria-hidden="true">{% render 'icon', name: 'chevron' %}</span>
                      </button>
                    </div>
                  {%- endif -%}
                </div>

              {%- when 'pills' -%}
                {%- comment -%}
                  One row that scrolls, not a block that wraps. Wrapped rows
                  make three short guarantees look like a paragraph of terms.
                {%- endcomment -%}
                <div class="bb__pills" {{ block.shopify_attributes }}>
                  {%- assign pills = block.settings.items | split: ',' -%}
                  {%- for p in pills -%}
                    <span class="bb__pill" data-pop style="{% if block.settings.bg != blank %}background: {{ block.settings.bg }};{% endif %}">{{ p | strip }}</span>
                  {%- endfor -%}
                </div>

              {%- when 'text' -%}
                <div class="bb__free-text rte" {{ block.shopify_attributes }}>{{ block.settings.content }}</div>

            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>

      {%- comment -%}
        Landing content. On desktop it sits under the gallery in column one;
        on a phone it comes after the buy box, so the order is images → price
        and order button → the long read.
      {%- endcomment -%}
      {%- liquid
        assign media_blocks = section.blocks | where: 'type', 'landing_media'
        assign review_blocks = section.blocks | where: 'type', 'review'
        assign media_alt_default = product.title
        assign has_desc = false
        if section.settings.show_description and product.description != blank
          assign has_desc = true
        endif

        # The auto landing page needs a second photo to be worth a section:
        # with one image the gallery has already shown everything there is.
        assign has_auto_landing = false
        if media_blocks.size == 0 and section.settings.landing_from_media and product.media.size > 1
          assign has_auto_landing = true
        endif

        assign has_landing = false
        if has_desc or media_blocks.size > 0 or has_auto_landing
          assign has_landing = true
        endif

        assign spec_block = section.blocks | where: 'type', 'specs' | first
      -%}

      {%- if has_landing or review_blocks.size > 0 or spec_block -%}
        <div class="pdp__details pdp__details--{{ section.settings.description_column | default: 'buybox' }}">

          {%- comment -%}
            Product details.

            A spec grid, not a paragraph: the shopper is checking one fact —
            the material, the capacity, the warranty — and a sentence buries
            it. Three columns because two reads as a form and four squeezes
            the values onto a second line at 360px.

            The merchant types the rows, but a shop that has typed none still
            gets a table: the product's own type, vendor and SKU are real
            Shopify fields, and its option names are the facts the shopper is
            choosing between anyway.
          {%- endcomment -%}
          {%- if spec_block -%}
            {%- liquid
              assign spec_keys = ''
              assign spec_vals = ''
              # Liquid assign has no block scope: naming these k and v
              # overwrote `v`, the product variant this whole section runs on,
              # from here to the end of the file. The mobile order form was
              # then rendered with a spec string in place of the variant and
              # shipped a unit price of 0 — the shopper reached the
              # confirmation owing the delivery fee and nothing for the item.
              for i in (1..9)
                assign spec_kk = 'k' | append: i
                assign spec_vk = 'v' | append: i
                assign spec_k1 = spec_block.settings[spec_kk]
                assign spec_v1 = spec_block.settings[spec_vk]
                if spec_k1 != blank and spec_v1 != blank
                  assign spec_keys = spec_keys | append: '|' | append: spec_k1
                  assign spec_vals = spec_vals | append: '|' | append: spec_v1
                endif
              endfor

              if spec_keys == blank and spec_block.settings.auto_fill
                if product.type != blank
                  assign spec_keys = spec_keys | append: '|' | append: spec_block.settings.auto_type_label
                  assign spec_vals = spec_vals | append: '|' | append: product.type
                endif
                if product.vendor != blank
                  assign spec_keys = spec_keys | append: '|' | append: spec_block.settings.auto_vendor_label
                  assign spec_vals = spec_vals | append: '|' | append: product.vendor
                endif
                if v.sku != blank
                  assign spec_keys = spec_keys | append: '|' | append: spec_block.settings.auto_sku_label
                  assign spec_vals = spec_vals | append: '|' | append: v.sku
                endif
                for option in product.options_with_values
                  assign opt_values = option.values | join: ', '
                  assign spec_keys = spec_keys | append: '|' | append: option.name
                  assign spec_vals = spec_vals | append: '|' | append: opt_values
                endfor
              endif

              assign spec_k = spec_keys | remove_first: '|' | split: '|'
              assign spec_v = spec_vals | remove_first: '|' | split: '|'
            -%}

            {%- if spec_k.size > 0 -%}
              <section class="pdetails" data-reveal {{ spec_block.shopify_attributes }}>
                <div class="pdetails__head">
                  <h2 class="pdetails__title">{{ spec_block.settings.title }}</h2>
                  {%- if spec_block.settings.action_label != blank -%}
                    <button class="pdetails__action" type="button"
                            data-sheet-open aria-controls="SpecSheet-{{ spec_block.id }}">
                      {{ spec_block.settings.action_label }}
                      {% render 'icon', name: 'chevron' %}
                    </button>
                  {%- endif -%}
                </div>

                {%- comment -%}
                  Three per row, so the grid only fills the cells it has —
                  a trailing gap is the background showing through, which is
                  what the 1px gap over a border-coloured backdrop draws.
                {%- endcomment -%}
                <div class="pdetails__grid">
                  {%- for k in spec_k limit: 9 -%}
                    <div class="pdetails__cell">
                      <span class="pdetails__key">{{ k }}</span>
                      <span class="pdetails__val">{{ spec_v[forloop.index0] }}</span>
                    </div>
                  {%- endfor -%}
                </div>

                {%- if spec_block.settings.more_label != blank -%}
                  <button class="pdetails__more" type="button"
                          data-sheet-open aria-controls="SpecSheet-{{ spec_block.id }}">
                    {{ spec_block.settings.more_label }}
                    {% render 'icon', name: 'chevron' %}
                  </button>
                {%- endif -%}

                {%- if spec_block.settings.guide_label != blank -%}
                  <button class="pdetails__guide" type="button"
                          data-sheet-open aria-controls="GuideSheet-{{ spec_block.id }}">
                    {% render 'icon', name: 'tag' %}
                    {{ spec_block.settings.guide_label }}
                    <span class="pdetails__guide-val">{{ spec_block.settings.guide_value }}</span>
                    {% render 'icon', name: 'chevron' %}
                  </button>
                {%- endif -%}
              </section>
            {%- endif -%}
          {%- endif -%}

          {%- if has_landing -%}
            <section class="landing" data-reveal aria-labelledby="Desc-{{ section.id }}">
              <h2 class="landing__title" id="Desc-{{ section.id }}">
                {{ section.settings.description_title }}
              </h2>

              {%- if has_desc -%}
                <div class="landing__stack rte">{{ product.description }}</div>
              {%- endif -%}

              {%- comment -%}
                Landing media. Images and videos in whatever order the merchant
                arranges the blocks — this is where a product is actually sold,
                so it is theirs to build, not a fixed template.
              {%- endcomment -%}
              {%- for block in media_blocks -%}
                {%- comment -%}
                  A filter cannot appear inside a filter's argument. Written
                  as `alt: block.settings.alt | default: product.title` the
                  whole image_tag fails to parse and the image never renders
                  — which is why this section was showing its heading and
                  nothing else. Resolve first, pass a finished value.
                {%- endcomment -%}
                {%- assign media_alt = block.settings.alt | default: product.title -%}
                <figure class="landing__item" {{ block.shopify_attributes }}>
                  {%- if block.settings.video != blank -%}
                    {{ block.settings.video
                       | video_tag:
                           image_size: '1000x',
                           controls: true,
                           playsinline: true,
                           preload: 'metadata' }}
                  {%- elsif block.settings.video_url != blank -%}
                    <div class="landing__embed">
                      {{ block.settings.video_url | external_video_tag: loading: 'lazy' }}
                    </div>
                  {%- elsif block.settings.image != blank -%}
                    {{ block.settings.image
                       | image_url: width: 1200
                       | image_tag:
                           widths: '400,700,1000,1200',
                           sizes: '(min-width: 990px) 46vw, 100vw',
                           alt: media_alt,
                           loading: 'lazy' }}
                  {%- endif -%}

                  {%- if block.settings.caption != blank -%}
                    <figcaption class="landing__caption">{{ block.settings.caption }}</figcaption>
                  {%- endif -%}
                </figure>
              {%- endfor -%}

              {%- comment -%}
                Fallback landing page.

                A merchant who has not built one still has product photos, and
                a description that ends after two lines of text is the version
                of this page that does not sell. So when there are no media
                blocks the product's own media runs full width down the page,
                large, in the order the merchant arranged it in the admin —
                the same images as the gallery, read rather than swiped.

                The first is skipped: it is already the photo filling the top
                of the screen, and repeating it immediately reads as a fault.
                Merchant blocks always win — the moment one exists, this stops.
              {%- endcomment -%}
              {%- if has_auto_landing -%}
                {%- assign landing_cap = section.settings.landing_media_count | default: 8 -%}
                {%- for media in product.media offset: 1 limit: landing_cap -%}
                  <figure class="landing__item landing__item--auto">
                    {%- case media.media_type -%}
                      {%- when 'video' -%}
                        {{ media | video_tag: image_size: '1000x', controls: true, playsinline: true, preload: 'none' }}
                      {%- when 'external_video' -%}
                        <div class="landing__embed">{{ media | external_video_tag: loading: 'lazy' }}</div>
                      {%- when 'image' -%}
                        {{ media
                           | image_url: width: 1200
                           | image_tag:
                               widths: '400,700,1000,1200',
                               sizes: '(min-width: 990px) 46vw, 100vw',
                               alt: media_alt_default,
                               loading: 'lazy' }}
                    {%- endcase -%}
                  </figure>
                {%- endfor -%}
              {%- endif -%}
            </section>
          {%- endif -%}

          {%- comment -%}
            Reviews. Shopify has no review object of its own, so these are
            blocks the merchant fills in — which also means they must never be
            presented as verified by anyone but the merchant.
          {%- endcomment -%}
          {%- if review_blocks.size > 0 -%}
            <section class="reviews" data-reveal aria-labelledby="Rev-{{ section.id }}">
              <div class="reviews__head">
                <h2 class="landing__title" id="Rev-{{ section.id }}">
                  {{ section.settings.reviews_title | default: 'Avis clients' }}
                </h2>

                {%- assign r = product.metafields.reviews.rating.value -%}
                {%- if r != blank -%}
                  {%- assign pct = r.rating | times: 100.0 | divided_by: r.scale_max | round: 2 -%}
                  <span class="reviews__score">
                    {{ r.rating }}
                    <span class="stars reviews__stars" style="--stars-fill: {{ pct }}%" aria-hidden="true"></span>
                  </span>
                {%- endif -%}

                <span class="reviews__count">{{ review_blocks.size }} {{ section.settings.reviews_count_label | default: 'avis' }}</span>
              </div>

              {%- comment -%}
                Provenance bar.

                It is the merchant's own statement, not the theme's — these
                reviews are blocks they typed, and nothing here verified them.
                So it is a setting they fill in and can empty, with the schema
                telling them to keep it only if it is true of their shop.
              {%- endcomment -%}
              {%- if section.settings.reviews_verified_text != blank -%}
                <p class="reviews__verified">
                  <span class="reviews__verified-mark">{% render 'icon', name: 'badge-check' %}</span>
                  {{ section.settings.reviews_verified_text }}
                </p>
              {%- endif -%}

              {%- for block in review_blocks -%}
                {%- assign rpct = block.settings.rating | times: 20 -%}
                <article class="review" {{ block.shopify_attributes }}>
                  <div class="review__head">
                    <span class="review__avatar" aria-hidden="true">
                      {{ block.settings.author | default: '?' | slice: 0 | upcase }}
                    </span>
                    <span class="review__name">{{ block.settings.author }}</span>
                    <span class="stars review__stars" style="--stars-fill: {{ rpct }}%"
                          aria-label="{{ block.settings.rating }}/5"></span>
                    {%- if block.settings.date != blank -%}
                      <span class="review__sep" aria-hidden="true">·</span>
                      <span class="review__meta">{{ block.settings.date }}</span>
                    {%- endif -%}
                    {%- if block.settings.tag != blank -%}
                      <span class="review__tag">{{ block.settings.tag }}</span>
                    {%- endif -%}
                  </div>

                  {%- if block.settings.text != blank -%}
                    <p class="review__text">{{ block.settings.text }}</p>
                  {%- endif -%}

                  {%- if block.settings.photo != blank -%}
                    {{ block.settings.photo
                       | image_url: width: 480
                       | image_tag:
                           class: 'review__photo',
                           widths: '240,480',
                           alt: '',
                           loading: 'lazy' }}
                  {%- endif -%}
                </article>
              {%- endfor -%}
            </section>
          {%- comment -%}
            Related products.

            A shopper who has read this far and not ordered is about to
            leave; the only thing worth showing them is another product. The
            source is the merchant's choice because "related" means different
            things per shop: a collection they curate, or — with nothing
            chosen — whatever else is in the collection this product was
            reached through, which needs no setup at all.

            Reuses the catalog card, so one card setting still governs every
            grid on the storefront.
          {%- endcomment -%}
          {%- if section.settings.show_related -%}
            {%- liquid
              assign related_source = collections[section.settings.related_collection]
              if related_source == blank or related_source.products.size == 0
                assign related_source = collection
              endif
              if related_source == blank or related_source.products.size == 0
                assign related_source = collections.all
              endif
              assign related_limit = section.settings.related_count | default: 6
              # One extra is fetched because this product is filtered back out
              # of its own list, which would otherwise leave a short last row.
              assign related_fetch = related_limit | plus: 1
              assign related_shown = 0
            -%}

            {%- capture related_cards -%}
              {%- for other in related_source.products limit: related_fetch -%}
                {%- if other.id != product.id and related_shown < related_limit -%}
                  {%- assign related_shown = related_shown | plus: 1 -%}
                  {% render 'product-card', card: other, index: forloop.index0 %}
                {%- endif -%}
              {%- endfor -%}
            {%- endcapture -%}

            {%- if related_shown > 0 -%}
              <section class="related" data-reveal aria-labelledby="Rel-{{ section.id }}">
                <h2 class="related__title" id="Rel-{{ section.id }}">
                  {{ section.settings.related_title }}
                </h2>
                <div class="cgrid" data-reveal-stagger>{{ related_cards }}</div>
              </section>
            {%- endif -%}
          {%- endif -%}

          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

  {%- comment -%}
    Detail sheets. One per promise row, rendered outside the buy box so the
    sticky column never traps them, and only for blocks the merchant actually
    placed.
  {%- endcomment -%}
  {%- for block in section.blocks -%}
    {%- case block.type -%}

      {%- when 'specs' -%}
        {%- capture spec_content -%}
          <table class="tsheet__table">
            {%- for i in (1..9) -%}
              {%- liquid
                assign kk = 'k' | append: i
                assign vk = 'v' | append: i
                assign sk = block.settings[kk]
                assign sv = block.settings[vk]
              -%}
              {%- if sk != blank and sv != blank -%}
                <tr><th scope="row">{{ sk }}</th><td>{{ sv }}</td></tr>
              {%- endif -%}
            {%- endfor -%}
            {%- comment -%}
              The product's own fields go in the sheet whether or not the grid
              above fell back to them — the sheet is the full record, and a
              merchant who typed three rows still has a type and a vendor.
            {%- endcomment -%}
            {%- if block.settings.auto_fill -%}
              {%- if product.type != blank -%}
                <tr><th scope="row">{{ block.settings.auto_type_label }}</th><td>{{ product.type }}</td></tr>
              {%- endif -%}
              {%- if product.vendor != blank -%}
                <tr><th scope="row">{{ block.settings.auto_vendor_label }}</th><td>{{ product.vendor }}</td></tr>
              {%- endif -%}
              {%- if v.sku != blank -%}
                <tr><th scope="row">{{ block.settings.auto_sku_label }}</th><td>{{ v.sku }}</td></tr>
              {%- endif -%}
              {%- for option in product.options_with_values -%}
                {%- assign opt_all = option.values | join: ', ' -%}
                <tr><th scope="row">{{ option.name }}</th><td>{{ opt_all }}</td></tr>
              {%- endfor -%}
            {%- endif -%}
          </table>
          {%- if block.settings.sheet_note != blank -%}
            <p class="tsheet__note">
              {% render 'icon', name: 'check' %} {{ block.settings.sheet_note }}
            </p>
          {%- endif -%}
        {%- endcapture -%}
        {%- assign spec_sheet_id = 'SpecSheet-' | append: block.id -%}
        {% render 'trust-sheet',
           id: spec_sheet_id,
           title: block.settings.title,
           icon: 'box-fill',
           close_label: section.settings.close_label,
           content: spec_content %}

        {%- if block.settings.guide_label != blank -%}
          {%- capture guide_content -%}
            {%- if block.settings.guide_table != blank -%}
              <div class="tsheet__rich rte">{{ block.settings.guide_table }}</div>
            {%- endif -%}
            {%- if block.settings.guide_image != blank -%}
              {%- assign guide_alt = block.settings.guide_label -%}
              {{ block.settings.guide_image
                 | image_url: width: 900
                 | image_tag: widths: '400,700,900', alt: guide_alt, loading: 'lazy' }}
            {%- endif -%}
          {%- endcapture -%}
          {%- assign guide_sheet_id = 'GuideSheet-' | append: block.id -%}
          {% render 'trust-sheet',
             id: guide_sheet_id,
             title: block.settings.guide_label,
             icon: 'tag',
             close_label: section.settings.close_label,
             content: guide_content %}
        {%- endif -%}

      {%- when 'rank' -%}
        {%- capture rank_content -%}
          <ol class="tnum">
            {%- for i in (1..3) -%}
              {%- liquid
                assign rtk = 'rank' | append: i | append: '_title'
                assign rbk = 'rank' | append: i | append: '_body'
                assign rt = block.settings[rtk]
                assign rb = block.settings[rbk]
              -%}
              {%- if rt != blank -%}
                <li class="tnum__item">
                  <span class="tnum__n">{{ forloop.index }}</span>
                  <div>
                    <p class="tnum__title">{{ rt }}</p>
                    {%- if rb != blank -%}<p class="tnum__body">{{ rb }}</p>{%- endif -%}
                  </div>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ol>
        {%- endcapture -%}
        {%- liquid
          assign rank_sheet_id = 'RankSheet-' | append: block.id
          assign rank_sheet_title = block.settings.sheet_title | default: block.settings.badge
        -%}
        {% render 'trust-sheet',
           id: rank_sheet_id,
           title: rank_sheet_title,
           icon: 'trophy',
           close_label: section.settings.close_label,
           content: rank_content %}

      {%- when 'shipping' -%}
        {%- capture ship_content -%}
          <table class="tsheet__table">
            {%- if block.settings.row1_label != blank -%}
              <tr>
                <th scope="row">{{ block.settings.row1_label }}</th>
                <td>
                  {%- assign carriers_block = section.blocks | where: 'type', 'carriers' | first -%}
                  {%- if carriers_block -%}
                    {%- assign cnames = carriers_block.settings.names | split: ',' -%}
                    <span class="tsheet__carriers">
                      {%- for n in cnames -%}
                        {%- liquid
                          assign lk = 'logo_' | append: forloop.index
                          assign lg = carriers_block.settings[lk]
                          assign cname = n | strip
                        -%}
                        <span class="carrier">
                          {%- if lg != blank -%}
                            {{ lg | image_url: height: 20 | image_tag: class: 'carrier__logo', alt: cname, loading: 'lazy' }}
                          {%- endif -%}
                          <span class="carrier__name">{{ cname }}</span>
                        </span>
                      {%- endfor -%}
                    </span>
                  {%- else -%}
                    {{ block.settings.row1_value }}
                  {%- endif -%}
                </td>
              </tr>
            {%- endif -%}
            {%- if block.settings.row2_label != blank -%}
              <tr><th scope="row">{{ block.settings.row2_label }}</th><td>{{ block.settings.row2_value }}</td></tr>
            {%- endif -%}
            {%- if block.settings.row3_label != blank -%}
              <tr><th scope="row">{{ block.settings.row3_label }}</th><td>{{ block.settings.row3_value }}</td></tr>
            {%- endif -%}
          </table>
          {%- if block.settings.sheet_note != blank -%}
            <p class="tsheet__note">
              {% render 'icon', name: 'check' %} {{ block.settings.sheet_note }}
            </p>
          {%- endif -%}
        {%- endcapture -%}
        {%- liquid
          # render arguments are plain values, not expressions: a filter here is
          # a parse error and the whole sheet silently never renders. Resolve the
          # fallbacks first, pass finished values.
          assign ship_sheet_id = 'ShipSheet-' | append: block.id
          assign ship_title = block.settings.sheet_title | default: block.settings.title
          assign ship_icon = block.settings.icon_name | default: 'truck-fast'
        -%}
        {% render 'trust-sheet',
           id: ship_sheet_id,
           title: ship_title,
           icon: ship_icon,
           close_label: section.settings.close_label,
           content: ship_content %}

      {%- when 'guarantees' -%}
        {%- capture sec_content -%}
          <ol class="tnum">
            {%- for i in (1..6) -%}
              {%- liquid
                assign tk = 'sec' | append: i | append: '_title'
                assign bk = 'sec' | append: i | append: '_body'
                assign st = block.settings[tk]
                assign sb = block.settings[bk]
              -%}
              {%- if st != blank -%}
                <li class="tnum__item">
                  <span class="tnum__n">{{ forloop.index }}</span>
                  <div>
                    <p class="tnum__title">{{ st }}</p>
                    {%- if sb != blank -%}<p class="tnum__body">{{ sb }}</p>{%- endif -%}
                  </div>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ol>
        {%- endcapture -%}
        {%- liquid
          assign sec_sheet_id = 'SecSheet-' | append: block.id
          assign sec_icon = block.settings.icon_name_1 | default: 'shield-fill'
        -%}
        {% render 'trust-sheet',
           id: sec_sheet_id,
           title: block.settings.line_1,
           icon: sec_icon,
           close_label: section.settings.close_label,
           content: sec_content %}

        {%- capture guar_content -%}
          <ol class="tnum">
            {%- for i in (1..6) -%}
              {%- liquid
                assign tk = 'guar' | append: i | append: '_title'
                assign bk = 'guar' | append: i | append: '_body'
                assign gt = block.settings[tk]
                assign gb = block.settings[bk]
              -%}
              {%- if gt != blank -%}
                <li class="tnum__item">
                  <span class="tnum__n">{{ forloop.index }}</span>
                  <div>
                    <p class="tnum__title">{{ gt }}</p>
                    {%- if gb != blank -%}<p class="tnum__body">{{ gb }}</p>{%- endif -%}
                  </div>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ol>
        {%- endcapture -%}
        {%- liquid
          assign guar_sheet_id = 'GuarSheet-' | append: block.id
          assign guar_icon = block.settings.icon_name_2 | default: 'guarantee'
        -%}
        {% render 'trust-sheet',
           id: guar_sheet_id,
           title: block.settings.line_2,
           icon: guar_icon,
           close_label: section.settings.close_label,
           content: guar_content %}

    {%- endcase -%}
  {%- endfor -%}

{%- comment -%} Mobile: the buy box is far up the page, so keep a bar in reach. {%- endcomment -%}
{%- comment -%}
  Floating cart.

  The order bar below carries this product; the cart is a different job —
  getting back to what is already chosen — and burying it in the bar makes
  the two compete. It floats clear of both, above the bar and out of the
  thumb's path to it, and carries the merchant's delivery line so the reason
  to open it is on the bubble itself.

  Empty cart, no bubble: a floating zero is a floating dead end.
{%- endcomment -%}
{%- if section.settings.show_cart_bubble and cart.item_count > 0 -%}
  <a class="cartbub" href="{{ routes.cart_url }}" data-cart-open
     aria-label="{{ 'sections.header.cart_count' | t: count: cart.item_count }}">
    <span class="cartbub__disc">
      {% render 'icon', name: 'cart' %}
      {%- if section.settings.cart_bubble_label != blank -%}
        <span class="cartbub__label">{{ section.settings.cart_bubble_label }}</span>
      {%- endif -%}
      <span class="cartbub__count" aria-hidden="true">{{ cart.item_count }}</span>
    </span>
    {%- if section.settings.cart_bubble_note != blank -%}
      <span class="cartbub__note">{{ section.settings.cart_bubble_note }}</span>
    {%- endif -%}
  </a>
{%- endif -%}

{%- comment -%}
  Mobile order bar, two shapes for the same job.

  "bar" is a full-width strip pinned to the bottom edge; "pill" floats clear
  of it and carries a second line under the label, which is where the offer
  goes — "-45% aujourd'hui" converts harder than "Commander". Neither is
  better in the abstract: a bar looks more like a checkout and a pill looks
  more like an offer, and the merchant knows which their shop is.
{%- endcomment -%}
{%- comment -%}
  The confirmation, waiting.

  A merchant who has not created the confirmation page still has a customer
  who just placed an order, and that customer deserves the same screen — not
  a smaller version of it. So the identical card is rendered here, hidden,
  and takes over the viewport the moment the order lands. If the merchant HAS
  created the page, the form navigates there instead and this never appears.
{%- endcomment -%}
{%- if cod_block_count > 0 and settings.cod_thanks_url == blank -%}
  {{ 'thank-you.css' | asset_url | stylesheet_tag }}
  <div class="ty ty--overlay" data-ty data-ty-overlay hidden>
    {% render 'confirmation-card', heading_tag: 'h2' %}
  </div>
{%- endif -%}

{%- if section.settings.show_mobile_bar -%}
  {%- if section.settings.mobile_bar_style == 'pill' -%}
    <div class="order-float" data-order-bar>
      <span class="order-float__price">
        <b class="order-float__now">{{ v.price | money }}</b>
        {%- if on_sale -%}<s class="order-float__was">{{ v.compare_at_price | money }}</s>{%- endif -%}
      </span>
      {%- capture float_inner -%}
        <span class="order-float__main">{{ section.settings.mobile_cta_label }}</span>
        {%- if section.settings.mobile_cta_sub != blank -%}
          <span class="order-float__sub">{{ section.settings.mobile_cta_sub }}</span>
        {%- endif -%}
      {%- endcapture -%}
      {%- if cod_block_count > 0 -%}
        <button class="order-float__btn" type="button" data-cta-attention
                data-sheet-open aria-controls="CodSheet-{{ section.id }}">{{ float_inner }}</button>
      {%- else -%}
        <button class="order-float__btn" type="submit"
                form="AddToCart-{{ section.id }}">{{ float_inner }}</button>
      {%- endif -%}
    </div>
  {%- else -%}
    <div class="pdp__mobile-cta">
      <span class="pdp__mobile-price">
        <b>{{ v.price | money }}</b>
        {%- if on_sale -%}<s>{{ v.compare_at_price | money }}</s>{%- endif -%}
      </span>
      {%- if cod_block_count > 0 -%}
        <button class="bb__cta" type="button" data-cta-attention data-sheet-open aria-controls="CodSheet-{{ section.id }}">
          {{ section.settings.mobile_cta_label }}
        </button>
      {%- else -%}
        <button class="bb__cta" type="submit" form="AddToCart-{{ section.id }}">
          {{ section.settings.mobile_cta_label }}
        </button>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- for block in section.blocks -%}
    {%- if block.type == 'cod_form' -%}
      <div class="cod-sheet" id="CodSheet-{{ section.id }}" data-open="false">
        <div class="cod-sheet__scrim" data-sheet-close></div>
        <div class="cod-sheet__panel" role="dialog" aria-modal="true"
             aria-label="{{ block.settings.head_title | escape }}">
          {%- comment -%}
            No title here. The form's own banner sits directly below with the
            same sentence, plus an icon and the line about paying on delivery
            — it is the better of the two, so this bar keeps only the close
            button and gives the duplicate's height back to the fields. The
            dialog is still named, by aria-label on the panel above.
          {%- endcomment -%}
          <div class="cod-sheet__grip">
            <button class="cod-sheet__close" type="button" data-sheet-close
                    aria-label="{{ section.settings.close_label | escape }}">&#10005;</button>
          </div>
          {% render 'cod-form', id: cod_mobile_id, product: product, variant: v, block: block %}
        </div>
      </div>
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{% schema %}
{
  "name": "Page produit",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "checkbox",
      "id": "mobile_immersive",
      "label": "Image plein écran en haut (mobile)",
      "default": true,
      "info": "Masque l'en-tête au-dessus des photos sur mobile. Retour, recherche et panier flottent sur l'image."
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Forme des photos (mobile)",
      "options": [
        {
          "value": "3 / 4",
          "label": "Portrait 3:4 (recommandé)"
        },
        {
          "value": "4 / 5",
          "label": "Portrait 4:5"
        },
        {
          "value": "1 / 1",
          "label": "Carré"
