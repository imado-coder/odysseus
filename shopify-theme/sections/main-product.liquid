{%- comment -%}
  Product page. The media column scrolls, the buy box sticks.
  The buy box is a library of blocks: the merchant adds only what a given
  product needs, in the order they want, and every string is theirs.
{%- endcomment -%}
{{ 'product-page.css' | asset_url | stylesheet_tag }}
{{ 'pdp-mobile.css' | asset_url | stylesheet_tag }}
{{ 'cod-form.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Filters cannot be used inside an `if` condition, so the count is assigned
  first. The wilaya/commune data is 54KB, and only loaded when the merchant
  has actually placed the order form on the page.
{%- endcomment -%}
{%- liquid
  assign cod_blocks = section.blocks | where: 'type', 'cod_form'
  assign cod_block_count = cod_blocks | size
-%}
{%- if cod_block_count > 0 -%}
  <script src="{{ 'dz-locations.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- liquid
  assign v = product.selected_or_first_available_variant
  assign on_sale = false
  if v.compare_at_price > v.price
    assign on_sale = true
    assign off = v.compare_at_price | minus: v.price | times: 100.0 | divided_by: v.compare_at_price | round
  endif
-%}

<div class="pdp">
  <div class="pdp__inner">
    {%- if section.settings.show_breadcrumbs -%}
      <nav class="pdp__crumbs" aria-label="{{ 'general.breadcrumbs.label' | t }}">
        <a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a>
        <span class="pdp__crumb-sep" aria-hidden="true">&rsaquo;</span>
        {%- if collection -%}
          <a href="{{ collection.url }}">{{ collection.title }}</a>
          <span class="pdp__crumb-sep" aria-hidden="true">&rsaquo;</span>
        {%- endif -%}
        <span class="pdp__crumb-current">{{ product.title }}</span>
      </nav>
    {%- endif -%}

    <div class="pdp__grid">
      {%- comment -%}
        Three regions, not two. The description has to be able to sit below
        the buy box on a phone — price, options and the order button come
        straight after the images, because a shopper on a phone decides there.
        Keeping the description inside the media column made that impossible.
      {%- endcomment -%}
      <div class="pdp__media pdp__gallery">
        {% render 'product-gallery', product: product, variant: v %}
      </div>

      <div class="pdp__buybox" data-sticky-fit>
        <div class="bb">
          {%- for block in section.blocks -%}
            {%- case block.type -%}

              {%- when 'savings' -%}
                <div class="bb__savings {% if block.settings.style == 'flash' %}bb__savings--flash{% endif %}" {{ block.shopify_attributes }}>
                  <span class="bb__savings-flag">
                    {%- if block.settings.icon != blank %}<span aria-hidden="true">{{ block.settings.icon }}</span> {% endif -%}
                    {{ block.settings.flag }}
                  </span>
                  <span class="bb__savings-list">
                    {%- if block.settings.item_1 != blank -%}<span class="bb__savings-item"><span aria-hidden="true">&#10004;</span> {{ block.settings.item_1 }}</span>{%- endif -%}
                    {%- if block.settings.item_2 != blank -%}<span class="bb__savings-item"><span aria-hidden="true">&#10004;</span> {{ block.settings.item_2 }}</span>{%- endif -%}
                  </span>
                </div>

              {%- when 'title' -%}
                <div class="bb__title-row" {{ block.shopify_attributes }}>
                  <h1 class="bb__title">{{ product.title }}</h1>
                  {%- if block.settings.show_share -%}
                    <button class="bb__share" type="button" aria-label="{{ block.settings.share_label | escape }}">
                      <span aria-hidden="true">&#8618;</span>
                    </button>
                  {%- endif -%}
                </div>

              {%- when 'rating' -%}
                {%- assign r = product.metafields.reviews.rating.value -%}
                <div class="bb__rating" {{ block.shopify_attributes }}>
                  {%- if r != blank -%}
                    <span class="bb__rating-score">{{ r.rating }}</span>
                    {%- comment -%} Masked shape, filled by percentage — glyph half-stars are unavailable in most fonts. {%- endcomment -%}
                    {%- assign pct = r.rating | times: 100.0 | divided_by: r.scale_max | round: 2 -%}
                    <span class="stars bb__rating-stars" style="--stars-fill: {{ pct }}%" aria-hidden="true"></span>
                    <span class="visually-hidden">{{ 'products.product.rating' | t }} {{ r.rating }}/{{ r.scale_max }}</span>
                  {%- endif -%}
                  {%- if block.settings.sold_text != blank -%}
                    <span class="bb__rating-count">{{ block.settings.sold_text }}</span>
                  {%- endif -%}
                  {%- if block.settings.seller_label != blank -%}
                    <span class="bb__rating-sep" aria-hidden="true">|</span>
                    <span>{{ block.settings.seller_label }}</span>
                    {%- if block.settings.seller_badge != blank -%}
                      <span class="bb__seller-badge"><span aria-hidden="true">&#9733;</span> {{ block.settings.seller_badge }}</span>
                    {%- endif -%}
                  {%- endif -%}
                </div>

              {%- when 'rank' -%}
                <div class="bb__rank" {{ block.shopify_attributes }}>
                  <span class="bb__rank-badge" style="{% if block.settings.badge_bg != blank %}background: {{ block.settings.badge_bg }};{% endif %}">{{ block.settings.badge }}</span>
                  <span>{{ block.settings.text }}</span>
                </div>

              {%- when 'price' -%}
                <div class="bb__price-row" {{ block.shopify_attributes }}>
                  {%- if on_sale and block.settings.show_compare -%}
                    <s class="bb__price-was">
                      <span class="visually-hidden">{{ 'products.product.regular_price' | t }} </span>{{ v.compare_at_price | money }}
                    </s>
                  {%- endif -%}
                  <span class="bb__price-deal">
                    {%- if block.settings.icon != blank -%}<span aria-hidden="true">{{ block.settings.icon }}</span>{%- endif -%}
                    {%- if block.settings.label != blank -%}<span class="bb__price-label">{{ block.settings.label }}</span>{%- endif -%}
                    <span class="bb__price-now">{{ v.price | money }}</span>
                  </span>
                </div>
                {%- if block.settings.note != blank or on_sale -%}
                  <div class="bb__price-note">
                    {%- if block.settings.note != blank -%}<span>{{ block.settings.note }}</span>{%- endif -%}
                    {%- if on_sale and block.settings.show_discount -%}
                      <span class="bb__off" style="{% if block.settings.off_bg != blank %}background: {{ block.settings.off_bg }};{% endif %}">
                        {{ block.settings.off_prefix }}{{ off }}{{ block.settings.off_suffix }}
                      </span>
                    {%- endif -%}
                  </div>
                {%- endif -%}

              {%- when 'notice' -%}
                <span class="bb__notice" {{ block.shopify_attributes }}
                      style="{% if block.settings.color != blank %}border-color: {{ block.settings.color }}; color: {{ block.settings.color }};{% endif %}">
                  {{ block.settings.text }}
                  {%- if block.settings.show_info %} <span aria-hidden="true">&#9432;</span>{% endif -%}
                </span>

              {%- when 'promo' -%}
                <div class="bb__promo" {{ block.shopify_attributes }}
                     style="{% if block.settings.color != blank %}border-color: {{ block.settings.color }};{% endif %}">
                  <div class="bb__promo-head" style="{% if block.settings.color != blank %}background: {{ block.settings.color }};{% endif %}">
                    <span class="bb__promo-name">{{ block.settings.name }}</span>
                    <span class="bb__promo-rule" aria-hidden="true"></span>
                    {%- if block.settings.deadline != blank -%}
                      <span class="bb__promo-timer" data-countdown="{{ block.settings.deadline }}">
                        <span aria-hidden="true">&#9201;</span> {{ block.settings.timer_label }}
                        <span data-countdown-out>--:--:--</span>
                      </span>
                    {%- endif -%}
                  </div>
                  {%- if block.settings.body != blank -%}
                    <div class="bb__promo-body">{{ block.settings.body }}</div>
                  {%- endif -%}
                </div>

              {%- when 'variants' -%}
                {%- unless product.has_only_default_variant -%}
                  {% render 'variant-picker', product: product, variant: v, block: block %}
                {%- endunless -%}

              {%- when 'quantity' -%}
                <div class="bb__qty-row" {{ block.shopify_attributes }}>
                  <label>{{ block.settings.label }}
                    <select class="bb__qty-select" name="quantity" form="AddToCart-{{ section.id }}">
                      {%- for i in (1..block.settings.max) -%}<option>{{ i }}</option>{%- endfor -%}
                    </select>
                  </label>
                  {%- if block.settings.sold_text != blank -%}
                    <span class="bb__qty-sold"><span aria-hidden="true">&#9670;</span> {{ block.settings.sold_text }}</span>
                  {%- endif -%}
                </div>

              {%- when 'cta' -%}
                {%- form 'product', product, id: 'AddToCart-' | append: section.id -%}
                  <input type="hidden" name="id" value="{{ v.id }}">
                  <button class="bb__cta" type="submit" name="add"
                          {% unless v.available %}disabled{% endunless %}
                          style="{% if block.settings.bg != blank %}background: {{ block.settings.bg }};{% endif %}"
                          {{ block.shopify_attributes }}>
                    {%- if v.available -%}{{ block.settings.label }}{%- else -%}{{ block.settings.sold_out_label }}{%- endif -%}
                  </button>
                {%- endform -%}

              {%- when 'cod_form' -%}
                {%- comment -%}
                  A form that is already open on arrival is a wall of fields
                  before the shopper has decided anything. Default is the
                  call-to-action: one button carrying the offer, the form
                  revealed on the tap that means "I want this". Merchants who
                  prefer the form in view can switch to `inline`.
                {%- endcomment -%}
                {%- if block.settings.display == 'inline' -%}
                  <div {{ block.shopify_attributes }}>
                    {% render 'cod-form', id: 'cod-' | append: section.id, product: product, variant: v, block: block %}
                  </div>
                {%- else -%}
                  <div class="cod-wrap" data-cod-wrap data-open="false" {{ block.shopify_attributes }}>
                    <button class="cod-cta" type="button" data-cod-reveal>
                      <span class="cod-cta__main">
                        {%- if on_sale and block.settings.cta_show_discount -%}
                          <span class="cod-cta__off">-{{ off }}%</span>
                        {%- endif -%}
                        {{ block.settings.cta_label | default: 'Commander — paiement à la livraison' }}
                      </span>
                      {%- if block.settings.cta_note != blank -%}
                        <span class="cod-cta__note">{{ block.settings.cta_note }}</span>
                      {%- endif -%}
                    </button>

                    <div class="cod-wrap__panel">
                      {% render 'cod-form', id: 'cod-' | append: section.id, product: product, variant: v, block: block %}
                    </div>
                  </div>
                {%- endif -%}

              {%- when 'shipping' -%}
                <div class="bb__trust" {{ block.shopify_attributes }}>
                  {%- if block.settings.title != blank -%}
                    <span class="bb__ship-title">
                      <span aria-hidden="true">{{ block.settings.icon }}</span> {{ block.settings.title }}
                    </span>
                  {%- endif -%}
                  {%- if block.settings.line != blank -%}
                    <span class="bb__ship-line">{{ block.settings.line }}</span>
                  {%- endif -%}
                </div>

              {%- when 'carriers' -%}
                <div class="bb__carriers" {{ block.shopify_attributes }}>
                  {%- if block.settings.label != blank -%}
                    <span class="bb__ship-line">{{ block.settings.label }}</span>
                  {%- endif -%}
                  {%- assign names = block.settings.names | split: ',' -%}
                  {%- for n in names -%}
                    <span class="bb__carrier">
                      <span class="bb__carrier-logo">{{ n | strip | slice: 0, 3 | upcase }}</span> {{ n | strip }}
                    </span>
                  {%- endfor -%}
                </div>

              {%- when 'guarantees' -%}
                <div class="bb__trust" {{ block.shopify_attributes }}>
                  {%- if block.settings.line_1 != blank -%}
                    <span class="bb__trust-row"><span aria-hidden="true">{{ block.settings.icon_1 }}</span> {{ block.settings.line_1 }}</span>
                  {%- endif -%}
                  {%- if block.settings.line_2 != blank -%}
                    <span class="bb__trust-row"><span aria-hidden="true">{{ block.settings.icon_2 }}</span> {{ block.settings.line_2 }}</span>
                  {%- endif -%}
                </div>

              {%- when 'pills' -%}
                <div class="bb__pills" {{ block.shopify_attributes }}>
                  {%- assign pills = block.settings.items | split: ',' -%}
                  {%- for p in pills -%}
                    <span class="bb__pill" style="{% if block.settings.bg != blank %}background: {{ block.settings.bg }};{% endif %}">{{ p | strip }}</span>
                  {%- endfor -%}
                </div>

              {%- when 'text' -%}
                <div class="bb__free-text rte" {{ block.shopify_attributes }}>{{ block.settings.content }}</div>

            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>

      {%- comment -%}
        Landing content. On desktop it sits under the gallery in column one;
        on a phone it comes after the buy box, so the order is images → price
        and order button → the long read.
      {%- endcomment -%}
      {%- if section.settings.show_description and product.description != blank -%}
        <div class="pdp__details pdp__details--{{ section.settings.description_column | default: 'gallery' }}">
          <section class="landing" aria-labelledby="Desc-{{ section.id }}">
            <h2 class="landing__title" id="Desc-{{ section.id }}">
              {{ section.settings.description_title }}
            </h2>
            <div class="landing__stack rte">{{ product.description }}</div>
          </section>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{%- comment -%} Mobile: the buy box is far up the page, so keep a bar in reach. {%- endcomment -%}
{%- if section.settings.show_mobile_bar -%}
  <div class="pdp__mobile-cta">
    <span class="pdp__mobile-price">
      <b>{{ v.price | money }}</b>
      {%- if on_sale -%}<s>{{ v.compare_at_price | money }}</s>{%- endif -%}
    </span>
    {%- if cod_block_count > 0 -%}
      <button class="bb__cta" type="button" data-sheet-open aria-controls="CodSheet-{{ section.id }}">
        {{ section.settings.mobile_cta_label }}
      </button>
    {%- else -%}
      <button class="bb__cta" type="submit" form="AddToCart-{{ section.id }}">
        {{ section.settings.mobile_cta_label }}
      </button>
    {%- endif -%}
  </div>

  {%- for block in section.blocks -%}
    {%- if block.type == 'cod_form' -%}
      <div class="cod-sheet" id="CodSheet-{{ section.id }}" data-open="false">
        <div class="cod-sheet__scrim" data-sheet-close></div>
        <div class="cod-sheet__panel" role="dialog" aria-modal="true"
             aria-label="{{ block.settings.head_title | escape }}">
          <div class="cod-sheet__grip">
            <span class="cod-sheet__grip-title">{{ block.settings.head_title }}</span>
            <button class="cod-sheet__close" type="button" data-sheet-close
                    aria-label="{{ section.settings.close_label | escape }}">&#10005;</button>
          </div>
          {% render 'cod-form', id: 'cod-mobile-' | append: section.id, product: product, variant: v, block: block %}
        </div>
      </div>
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{% schema %}
{
  "name": "Page produit",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Afficher le fil d'Ariane",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Afficher la description sous les images",
      "default": true
    },
    {
      "type": "text",
      "id": "description_title",
      "label": "Titre de la description",
      "default": "Détails du produit"
    },
    {
      "type": "select",
      "id": "description_column",
      "label": "Colonne de la description",
      "options": [
        {
          "value": "buybox",
          "label": "À droite, sous le bloc d'achat"
        },
        {
          "value": "gallery",
          "label": "À gauche, sous les images"
        }
      ],
      "default": "buybox",
      "info": "Sur mobile la description passe toujours après le bouton de commande."
    },
    {
      "type": "header",
      "content": "Barre mobile"
    },
    {
      "type": "checkbox",
      "id": "show_mobile_bar",
      "label": "Afficher la barre d'achat sur mobile",
      "default": true
    },
    {
      "type": "text",
      "id": "mobile_cta_label",
      "label": "Texte du bouton mobile",
      "default": "Commander maintenant"
    },
    {
      "type": "text",
      "id": "close_label",
      "label": "Bouton fermer (lecteurs d'écran)",
      "default": "Fermer"
    }
  ],
  "blocks": [
    {
      "type": "savings",
      "name": "Bandeau économies",
      "limit": 2,
      "settings": [
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            {
              "value": "normal",
              "label": "Économies (jaune)"
            },
            {
              "value": "flash",
              "label": "Ventes flash (orange)"
            }
          ],
          "default": "normal"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Icône du drapeau",
          "default": "💰"
        },
        {
          "type": "text",
          "id": "flag",
          "label": "Texte du drapeau",
          "default": "ÉCONOMIES"
        },
        {
          "type": "text",
          "id": "item_1",
          "label": "Avantage 1",
          "default": "Livraison gratuite"
        },
        {
          "type": "text",
          "id": "item_2",
          "label": "Avantage 2",
          "default": "Crédit en cas de retard"
        }
      ]
    },
    {
      "type": "title",
      "name": "Titre du produit",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_share",
          "label": "Afficher le bouton partager",
          "default": true
        },
        {
          "type": "text",
          "id": "share_label",
          "label": "Libellé du partage",
          "default": "Partager ce produit"
        }
      ]
    },
    {
      "type": "rating",
      "name": "Note et vendeur",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "sold_text",
          "label": "Texte des ventes",
          "default": "40 000+ ventes"
        },
        {
          "type": "text",
          "id": "seller_label",
          "label": "Libellé du vendeur",
          "default": "Vendu par"
        },
        {
          "type": "text",
          "id": "seller_badge",
          "label": "Badge du vendeur",
          "default": "Vendeur vedette"
        }
      ]
    },
    {
      "type": "rank",
      "name": "Classement",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "default": "#1 Meilleure vente"
        },
        {
          "type": "color",
          "id": "badge_bg",
          "label": "Couleur du badge"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texte à côté",
          "default": "dans sa catégorie"
        }
      ]
    },
    {
      "type": "price",
      "name": "Prix",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_compare",
          "label": "Afficher le prix barré",
          "default": true
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Icône avant le prix",
          "default": "⏰"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Étiquette avant le prix",
          "default": "Dernier jour"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Note sous le prix",
          "default": "après remises appliquées"
        },
        {
          "type": "header",
          "content": "Badge de réduction"
        },
        {
          "type": "checkbox",
          "id": "show_discount",
          "label": "Afficher le pourcentage",
          "default": true
        },
        {
          "type": "text",
          "id": "off_prefix",
          "label": "Avant le nombre"
        },
        {
          "type": "text",
          "id": "off_suffix",
          "label": "Après le nombre",
          "default": "% DE RÉDUCTION"
        },
        {
          "type": "color",
          "id": "off_bg",
          "label": "Couleur du badge"
        }
      ]
    },
    {
      "type": "notice",
      "name": "Alerte stock et prix",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texte",
          "default": "PRESQUE ÉPUISÉ"
        },
        {
          "type": "checkbox",
          "id": "show_info",
          "label": "Afficher l'icône info",
          "default": false
        },
        {
          "type": "color",
          "id": "color",
          "label": "Couleur"
        }
      ]
    },
    {
      "type": "promo",
      "name": "Panneau promotion",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Nom de la promo",
          "default": "GRANDES PROMOS"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Couleur"
        },
        {
          "type": "text",
          "id": "timer_label",
          "label": "Texte avant le compte à rebours",
          "default": "SE TERMINE DANS"
        },
        {
          "type": "text",
          "id": "deadline",
          "label": "Fin de la promo",
          "info": "Format : 2026-12-31 23:59"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Contenu du panneau"
        }
      ]
    },
    {
      "type": "variants",
      "name": "Choix des options",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "style",
          "label": "Affichage",
          "options": [
            {
              "value": "swatch",
              "label": "Vignettes images"
            },
            {
              "value": "button",
              "label": "Boutons texte"
            },
            {
              "value": "select",
              "label": "Liste déroulante"
            }
          ],
          "default": "swatch"
        },
        {
          "type": "checkbox",
          "id": "show_name",
          "label": "Afficher le nom de l'option choisie",
          "default": true
        }
      ]
    },
    {
      "type": "quantity",
      "name": "Quantité",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Libellé",
          "default": "Quantité"
        },
        {
          "type": "range",
          "id": "max",
          "min": 2,
          "max": 20,
          "step": 1,
          "label": "Quantité maximale",
          "default": 10
        },
        {
          "type": "text",
          "id": "sold_text",
          "label": "Texte à côté"
        }
      ]
    },
    {
      "type": "cta",
      "name": "Bouton d'achat",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Texte du bouton",
          "default": "Ajouter au panier"
        },
