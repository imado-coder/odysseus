{%- comment -%}
  Part 2 + Part 5 — header and categories mega menu.
  Nav links and mega-menu tiles are blocks. The menu itself is driven by a
  linklist so the merchant edits it in Navigation, not here.
{%- endcomment -%}
{%- assign menu = linklists[section.settings.mega_menu] -%}
<header class="mhead" data-variant="{{ section.settings.variant }}"
  style="
    {%- if section.settings.bg != blank %}--mhead-bg: {{ section.settings.bg }};{% endif -%}
    {%- if section.settings.fg != blank %}--mhead-fg: {{ section.settings.fg }};{% endif -%}
    {%- if section.settings.search_btn != blank %}--mhead-search-btn: {{ section.settings.search_btn }};{% endif -%}
  ">
  <div class="mhead__inner" data-logo="{{ section.settings.logo_position | default: 'start' }}"
       style="--name-size: {{ section.settings.name_size | default: 22 }}px;
              --name-weight: {{ section.settings.name_weight | default: '800' }};
              --name-spacing: {{ section.settings.name_spacing | default: -2 | times: 0.01 }}em;">
    {%- comment -%}
      The logo.

      An uploaded logo keeps its own proportions: it is given a height and
      allowed whatever width that implies. Forcing every logo into a fixed
      square crops wordmarks and stretches wide marks, which is why this is a
      height plus max-width rather than a tile. The tile is still available
      as a deliberate style for merchants who want the coloured badge look.

      Without an upload, the shop name is set as a wordmark rather than left
      as plain body text.
    {%- endcomment -%}
    {%- liquid
      assign logo_h = section.settings.logo_height | default: 40
      assign name_text = settings.logo_text | default: shop.name
    -%}
    <a class="mhead__logo mhead__logo--{{ section.settings.logo_style | default: 'plain' }}"
       href="{{ routes.root_url }}"
       style="--logo-h: {{ logo_h }}px; --logo-max: {{ section.settings.logo_max_width | default: 200 }}px;
              {% if section.settings.logo_bg != blank %}--logo-bg: {{ section.settings.logo_bg }};{% endif %}
              {% if section.settings.logo_fg != blank %}--logo-fg: {{ section.settings.logo_fg }};{% endif %}">
      {%- if settings.logo != blank -%}
        {%- assign w = logo_h | times: 4 -%}
        {{ settings.logo
           | image_url: height: logo_h, width: w
           | image_tag:
               class: 'mhead__logo-img',
               widths: '80,160,240,320,480',
               alt: shop.name,
               loading: 'eager',
               fetchpriority: 'high' }}
      {%- else -%}
        <span class="mhead__logo-word">
          {%- if section.settings.logo_mark != blank -%}
            <span class="mhead__logo-mark" aria-hidden="true">{{ section.settings.logo_mark }}</span>
          {%- endif -%}
          {{ name_text }}
        </span>
      {%- endif -%}

      {%- comment -%} An uploaded logo can still be paired with the name. {%- endcomment -%}
      {%- if section.settings.show_logo_text and settings.logo != blank -%}
        <span class="mhead__logo-text">{{ name_text }}</span>
      {%- endif -%}
    </a>

    <nav class="mhead__nav" aria-label="{{ section.settings.nav_aria | escape }}">
      {%- for block in section.blocks -%}
        {%- if block.type == 'link' -%}
          <a class="mhead__nav-link" href="{{ block.settings.url }}" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}<span aria-hidden="true">{{ block.settings.icon }}</span> {% endif -%}
            {{ block.settings.label }}
          </a>
        {%- endif -%}
      {%- endfor -%}

      {%- if section.settings.show_mega and menu.links.size > 0 -%}
        <span class="mhead__cat-wrap">
          <button class="mhead__cat" type="button" data-disclosure
                  aria-expanded="false" aria-haspopup="true" aria-controls="MegaMenu-{{ section.id }}">
            {{ section.settings.mega_label }}
            <span class="mhead__cat-caret" aria-hidden="true">&#9662;</span>
          </button>
          {% render 'mega-menu', menu: menu, id: section.id, variant: section.settings.mega_variant %}
        </span>
      {%- endif -%}
    </nav>

    {%- if section.settings.show_search -%}
      <form class="mhead__search" role="search" action="{{ routes.search_url }}" method="get">
        <label class="visually-hidden" for="HeaderSearch-{{ section.id }}">{{ section.settings.search_label }}</label>
        <input class="mhead__search-input" id="HeaderSearch-{{ section.id }}" type="search" name="q"
               value="{{ search.terms | escape }}" placeholder="{{ section.settings.search_placeholder | escape }}">
        <button class="mhead__search-btn" type="submit" aria-label="{{ section.settings.search_label | escape }}">
          <span aria-hidden="true">&#128269;</span>
        </button>
      </form>
    {%- endif -%}

    <div class="mhead__end">
      {%- if section.settings.show_account -%}
        <a class="mhead__acct" href="{{ routes.account_url }}">
          <span class="mhead__avatar" aria-hidden="true">
            {%- if customer -%}{{ customer.first_name | slice: 0 | upcase }}{%- else -%}&#128100;{%- endif -%}
          </span>
          <span class="mhead__acct-lines">
            <span class="mhead__acct-hi">
              {%- if customer -%}{{ section.settings.greeting }}, {{ customer.first_name }}{%- else -%}{{ section.settings.greeting_guest }}{%- endif -%}
            </span>
            <span class="mhead__acct-main">{{ section.settings.account_label }}</span>
          </span>
        </a>
      {%- endif -%}

      {%- if section.settings.help_label != blank -%}
        <a class="mhead__util" href="{{ section.settings.help_url }}">
          <span aria-hidden="true">{{ section.settings.help_icon }}</span> {{ section.settings.help_label }}
        </a>
      {%- endif -%}

      {%- if section.settings.show_locale and shop.published_locales.size > 1 -%}
        <a class="mhead__util" href="#">
          <span class="mhead__flag" aria-hidden="true">{{ request.locale.iso_code | upcase }}</span>
          {{ request.locale.endonym_name }}
        </a>
      {%- endif -%}

      {%- comment -%}
        A link first, so it still works without JavaScript; the controller
        intercepts the click and opens the drawer when JS is available. The
        count is driven by the drawer, not the Liquid cart object.
      {%- endcomment -%}
      <a class="mhead__cart" href="{{ routes.cart_url }}" data-cart-open
         aria-label="{{ 'sections.header.cart_count' | t: count: cart.item_count }}">
        {% render 'icon', name: 'cart' %}
        <span class="mhead__cart-count" data-cart-count hidden>0</span>
      </a>
    </div>
  </div>
</header>

{% schema %}
{
